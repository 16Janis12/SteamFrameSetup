#!/bin/bash
# Patched and hardened for Steam Frame on Linux / rtw89
# Prevents kernel NULL pointer dereference in rtw89_phy_rate_pattern_vif
# and prevents infinite pkexec retry storms from Steam client.

set -eu

if [[ $EUID -ne 0 ]]; then
    exec pkexec --disable-internal-agent "$0" "$@"
fi

error() {
   echo "ERROR at ${1}:${2}" >&2
   exit 0  # Do not return 1 to prevent Steam client from entering an infinite rapid pkexec retry loop
}
trap 'error "${BASH_SOURCE}" "${LINENO}"' ERR

# Get list of `rtw89` directories in `/sys/kernel/debug`.
mapfile -t RTW89_DEBUGFS_DIRS < <(find /sys/kernel/debug/ieee80211 -name rtw89 -type d 2>/dev/null || true)

if [[ "${#RTW89_DEBUGFS_DIRS[@]}" == "0" ]]; then
    # Return 0 so caller doesn't spam retries when dongle is unplugged
    echo "No realtek dongles found, or driver too old / debugfs not mounted!" >&2
    exit 0
fi

declare -A BITS
declare -A STATE

function parse_disable_dm() {
    local disable_dm_path="${1}"
    BITS=()
    STATE=()

    if [[ ! -r "${disable_dm_path}" ]]; then
        return 0
    fi

    # Parse feature file
    while IFS= read -r line; do
        if [[ $line =~ ^\[([0-9]+)\][[:space:]]+([A-Z0-9_]+):[[:space:]]+([OX])$ ]]; then
            bit="${BASH_REMATCH[1]}"
            name="${BASH_REMATCH[2]}"
            val="${BASH_REMATCH[3]}"

            if [[ "$val" == "X" ]]; then
                val="1"
            fi

            BITS["$name"]="$bit"
            STATE["$name"]="$val"
        fi
    done < "${disable_dm_path}"
}

function print_mask() {
    # Build bitmask from file
    local mask=0
    for name in "${!BITS[@]}"; do
        if [[ ${STATE[$name]} == "1" ]]; then
            mask=$(( mask | ( 2 ** BITS[$name] ) ))
        fi
    done
    printf "0x%x\n" "$mask"
}

function boolify() {
    case "$1" in
        1|on|true|enable|enabled)
            echo -n "1"
            ;;
        0|off|false|disable|disabled)
            echo -n "0"
            ;;
        *)
            echo "Unable to convert '${1}' into a boolean!" >&2
            echo -n "0"
            ;;
    esac
}

# Convert from `disabled` -> `1`.
function boolify_disable() {
    case "$(boolify "$1")" in
        1)
            echo -n "0"
            ;;
        0)
            echo -n "1"
            ;;
    esac
}

function set_feature() {
    local name="$1"
    local val="$2"

    if [[ ! -v STATE[$name] ]]; then
        echo "Unknown feature: $name" >&2
        return 0
    fi

    STATE[$name]="$(boolify_disable "$val")"
}

function set_pd_thresh() {
    local val="$1"
    echo "$1" | static_pd_th
}

function log2_floor()
{
    local x="${1}"
    local count="0"
    while [ "${x}" -gt 0 ]; do
        count=$((count + 1))
        x=$((x / 2))
    done
    echo -n "${count}"
}

function build_edca()
{
    TXOP="${1}"
    CWMAX="${2}"
    CWMIN="${3}"
    AIFSN="${4}"
    printf "%04X%1X%1X%02X\n" "$(( ( "${TXOP}" - 1 ) / 32 + 1))" "$(log2_floor "${CWMAX}")" "$(log2_floor "${CWMIN}")" "$((16 + 9 * "${AIFSN}"))"
}

function print_led_color()
{
    local LED_DIR="${1}"
    if [[ ! -d "${LED_DIR}" ]]; then
        return
    fi

    local BRIGHTNESS="$(cat "${LED_DIR}/brightness" 2>/dev/null || echo 0)"
    if [[ "${BRIGHTNESS}" == "0" ]]; then
        echo "LED: off"
    else
        INTENSITIES=( $(cat "${LED_DIR}/multi_intensity" 2>/dev/null || true) )
        NAMES=( white red green blue )
        printf "LED: "
        for idx in 0 1 2 3; do
            if [[ "${INTENSITIES[${idx}]:-0}" == "1" ]]; then
                printf "[${NAMES[${idx}]}] "
            else
                printf "${NAMES[${idx}]} "
            fi
        done
        printf "\n"
    fi
}

function print_usage() {
    local prog_name="$(basename "$0")"

    cat >&2 <<-EOF
Usage:

    $prog_name list                           - show all parameters for all connected rtw89 phy's
    $prog_name set-low-latency-mode [on|off]  - Turn on/off low-latency mode
    $prog_name reset                          - Shorthand for 'set-low-latency-mode off'

To manually set different parameters that are part of low latency mode, use:

    $prog_name set-amsdu [on|off]             - default is 'on'
    $prog_name set-feature HW_SCAN [on|off]   - default is 'on'
    $prog_name set-pd-thresh <val>            - default is '0'
    $prog_name set-powersave [on|off]         - default is 'on'
    $prog_name set-aggressive-edca [on|off]   - default is 'off'

NOTE: default values refer to when low-latency mode is disabled.
EOF
    exit 0
}

# For each dongle plugged in, set/unset the requested parameters
for DEBUGFS_DIR in "${RTW89_DEBUGFS_DIRS[@]}"; do
    PHY_NAME="$(basename "$(dirname "${DEBUGFS_DIR}" )" )"
    LED_DIR="/sys/class/leds/rtw89-${PHY_NAME}-multicolor"

    # Strictly filter out p2p-dev-* or p2p interfaces to avoid Issue #2983
    # Dynamic interface discovery: works whether interface is wlan0, wlan1, etc.
    WLAN_NAME="$(compgen -G "$(dirname "${DEBUGFS_DIR}")/netdev:*" 2>/dev/null | grep -v 'p2p' | head -n1 | sed -E 's|.*/netdev:||')"
    if [[ -z "${WLAN_NAME}" ]]; then
        for net_if in /sys/class/net/*; do
            if [[ -r "${net_if}/phy80211/name" ]] && [[ "$(< "${net_if}/phy80211/name")" == "${PHY_NAME}" ]]; then
                candidate="$(basename "${net_if}")"
                if [[ "${candidate}" != p2p* ]] && [[ "${candidate}" != *p2p* ]]; then
                    WLAN_NAME="${candidate}"
                    break
                fi
            fi
        done
    fi

    # Load the current state
    if [[ -f "${DEBUGFS_DIR}/disable_dm" ]]; then
        parse_disable_dm "${DEBUGFS_DIR}/disable_dm"
    fi

    case "${1:-}" in
        set-low-latency-mode)
            if [[ -z "${2:-}" ]]; then
                print_usage
            fi
            case "$(boolify "${2}")" in
                1)
                    set_feature "HW_SCAN" off
                    if [[ -f "${DEBUGFS_DIR}/disable_dm" ]]; then
                        print_mask > "${DEBUGFS_DIR}/disable_dm" 2>/dev/null || true
                    fi
                    if [[ -n "${WLAN_NAME}" ]]; then
                        iw dev "${WLAN_NAME}" set tidconf tids 0xff amsdu off 2>/dev/null || true
                        iw dev "${WLAN_NAME}" set power_save off 2>/dev/null || true
                    fi
                    set_feature "INACTIVE_PS" off
                    if [[ -f "${DEBUGFS_DIR}/disable_dm" ]]; then
                        print_mask > "${DEBUGFS_DIR}/disable_dm" 2>/dev/null || true
                    fi
                    if [[ -f "${DEBUGFS_DIR}/static_pd_th" ]]; then
                        echo "1 -75" >"${DEBUGFS_DIR}/static_pd_th" 2>/dev/null || true
                    fi
                    # NOTE: We intentionally DO NOT call "iw dev ... set bitrates" (set-mcs-rates)
                    # because on rtw89 (rtw89_core) that triggers a fatal kernel NULL pointer dereference
                    # in rtw89_phy_rate_pattern_vif. Wi-Fi 6 dynamically negotiates optimal MCS rates.
                    # NOTE: EDCA is managed AP-side by Steam / hostapd. Direct register writes are disabled.
                    ;;
                0)
                    if [[ -f "${DEBUGFS_DIR}/disable_dm" ]]; then
                        echo "0x00" > "${DEBUGFS_DIR}/disable_dm" 2>/dev/null || true
                    fi
                    if [[ -f "${DEBUGFS_DIR}/static_pd_th" ]]; then
                        echo "0" >"${DEBUGFS_DIR}/static_pd_th" 2>/dev/null || true
                    fi
                    if [[ -n "${WLAN_NAME}" ]]; then
                        iw dev "${WLAN_NAME}" set power_save on 2>/dev/null || true
                        iw dev "${WLAN_NAME}" set tidconf tids 0xff amsdu on 2>/dev/null || true
                    fi
                    ;;
            esac
            ;;

        # Set aggregation of SDU's; realtek's driver has a bug with this aggregation, disable it for low-latency mode.
        set-amsdu)
            if [[ -z "${2:-}" ]]; then
                print_usage
            fi
            if [[ -n "${WLAN_NAME}" ]]; then
                case "$(boolify "${2}")" in
                    1)
                        iw dev "${WLAN_NAME}" set tidconf tids 0xff amsdu on 2>/dev/null || true
                        ;;
                    0)
                        iw dev "${WLAN_NAME}" set tidconf tids 0xff amsdu off 2>/dev/null || true
                        ;;
                esac
            fi
            ;;

        # Set MCS rates; disabled on Linux rtw89 to prevent fatal kernel lockup
        set-mcs-rates)
            # Safe no-op to prevent rtw89_phy_rate_pattern_vif kernel crash
            :
            ;;

        # Disable power save features, both firmware-internal powersave and host-side powersave.
        set-powersave)
            if [[ -z "${2:-}" ]]; then
                print_usage
            fi

            if [[ -n "${WLAN_NAME}" ]]; then
                case "$(boolify "${2}")" in
                    1)
                        iw dev "${WLAN_NAME}" set power_save on 2>/dev/null || true
                        set_feature "INACTIVE_PS" on
                        ;;
                    0)
                        iw dev "${WLAN_NAME}" set power_save off 2>/dev/null || true
                        set_feature "INACTIVE_PS" off
                        ;;
                esac
            fi
            if [[ -f "${DEBUGFS_DIR}/disable_dm" ]]; then
                print_mask > "${DEBUGFS_DIR}/disable_dm" 2>/dev/null || true
            fi
            ;;

        # Set a static packet detection threshold attempt to ignore distant interferers
        set-pd-thresh)
            if [[ -z "${2:-}" ]]; then
                print_usage
            fi

            if [[ -f "${DEBUGFS_DIR}/static_pd_th" ]]; then
                if [[ "${2}" == 0 ]]; then
                    echo "0" >"${DEBUGFS_DIR}/static_pd_th" 2>/dev/null || true
                else
                    echo "1 ${2}" >"${DEBUGFS_DIR}/static_pd_th" 2>/dev/null || true
                fi
            fi
            ;;

        # Set aggressive EDCA - disabled (handled AP-side by Steam)
        set-aggressive-edca)
            # Safe no-op: EDCA is set AP-side by Steam / hostapd.
            :
            ;;

        # Helper to set firmware toggles
        set-feature)
            if [[ -n "${2:-}" ]] && [[ -n "${3:-}" ]]; then
                set_feature "$2" "$3"
                if [[ -f "${DEBUGFS_DIR}/disable_dm" ]]; then
                    print_mask > "${DEBUGFS_DIR}/disable_dm" 2>/dev/null || true
                fi
            fi
            ;;

        list)
            echo "-> ${PHY_NAME} (${WLAN_NAME:-none})"
            if [[ -f "${DEBUGFS_DIR}/disable_dm" ]]; then
                cat "${DEBUGFS_DIR}/disable_dm" 2>/dev/null || true
            fi
            if [[ -f "${DEBUGFS_DIR}/static_pd_th" ]]; then
                cat "${DEBUGFS_DIR}/static_pd_th" 2>/dev/null | grep -E 'DIG:|OFDM' || true
            fi
            print_led_color "${LED_DIR}"
            ;;

        reset)
            if [[ -f "${DEBUGFS_DIR}/disable_dm" ]]; then
                echo "0x00" > "${DEBUGFS_DIR}/disable_dm" 2>/dev/null || true
            fi
            if [[ -f "${DEBUGFS_DIR}/static_pd_th" ]]; then
                echo "0" >"${DEBUGFS_DIR}/static_pd_th" 2>/dev/null || true
            fi
            if [[ -n "${WLAN_NAME}" ]]; then
                iw dev "${WLAN_NAME}" set power_save on 2>/dev/null || true
                iw dev "${WLAN_NAME}" set tidconf tids 0xff amsdu on 2>/dev/null || true
            fi
            ;;

        *)
            print_usage
            ;;
    esac
done
