class SystemExecutor:
    """Handles execution of external commands and file operations with logging."""

    def __init__(self, dry_run: bool = False, root: Path = Path("/")):
        self.dry_run = dry_run
        self.root = root.resolve()
        self.logger = logging.getLogger(TOOL_NAME)

    def resolve_path(self, rel_or_abs: Path | str) -> Path:
        """Resolves a target path relative to self.root."""
        p = Path(rel_or_abs)
        if p.is_absolute():
            # Strip leading '/' to join cleanly with root
            p = Path(*p.parts[1:])
        return self.root / p

    def run_cmd(
        self,
        cmd: List[str],
        check: bool = False,
        capture_output: bool = True,
        simulate_in_dry_run: bool = False,
        dry_run_output: str = "",
    ) -> CommandResult:
        """Runs a subprocess command with logging and error handling."""
        cmd_str = " ".join(cmd)
        self.logger.debug(f"Command execution: {cmd_str} (dry_run={self.dry_run})")

        if self.dry_run and not simulate_in_dry_run:
            self.logger.info(f"[DRY-RUN] Would execute: {cmd_str}")
            return CommandResult(
                returncode=0,
                stdout=dry_run_output,
                stderr="",
                cmd=cmd,
            )

        try:
            res = subprocess.run(
                cmd,
                text=True,
                capture_output=capture_output,
                check=False,
            )
            self.logger.debug(
                f"Exit code {res.returncode} for: {cmd_str}\n"
                f"Stdout: {res.stdout.strip()}\nStderr: {res.stderr.strip()}"
            )
            if check and res.returncode != 0:
                raise subprocess.CalledProcessError(
                    res.returncode, cmd, output=res.stdout, stderr=res.stderr
                )
            return CommandResult(
                returncode=res.returncode,
                stdout=res.stdout if res.stdout else "",
                stderr=res.stderr if res.stderr else "",
                cmd=cmd,
            )
        except FileNotFoundError:
            self.logger.error(f"Binary not found: {cmd[0]}")
            return CommandResult(
                returncode=127,
                stdout="",
                stderr=f"Binary not found: {cmd[0]}",
                cmd=cmd,
            )
        except Exception as e:
            self.logger.error(f"Execution error for {cmd_str}: {e}")
            return CommandResult(
                returncode=1,
                stdout="",
                stderr=str(e),
                cmd=cmd,
            )

    def write_file(self, target_path: Path, content: str, mode: int = 0o644) -> None:
        """Writes content to target_path, respecting dry_run."""
        self.logger.debug(f"Writing file {target_path} (dry_run={self.dry_run})")
        if self.dry_run:
            self.logger.info(f"[DRY-RUN] Would write to {target_path}")
            return

        target_path.parent.mkdir(parents=True, exist_ok=True)
        target_path.write_text(content, encoding="utf-8")
        try:
            target_path.chmod(mode)
        except Exception as e:
            self.logger.warning(f"Could not chmod {mode:o} on {target_path}: {e}")

    def remove_file(self, target_path: Path) -> bool:
        """Removes a file if it exists, respecting dry_run."""
        if not target_path.exists():
            return False
        if self.dry_run:
            self.logger.info(f"[DRY-RUN] Would remove {target_path}")
            return True
        try:
            target_path.unlink()
            return True
        except Exception as e:
            self.logger.error(f"Failed to delete {target_path}: {e}")
            return False

