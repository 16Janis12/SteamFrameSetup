    def pre_checks(self) -> None:
        """Runs pre-execution checks and issues warnings."""
        # 1. Root check
        if os.geteuid() != 0 and self.executor.root == Path("/") and not self.executor.dry_run:
            print(Colors.colorize("FEHLER: 'steamframe-setup' benötigt Root-Rechte (bitte mit 'sudo steamframe-setup' ausführen).", Colors.RED))
            sys.exit(1)

        # 2. Kernel check
        res_kernel = self.executor.run_cmd(["uname", "-r"], simulate_in_dry_run=True)
        if res_kernel.success:
            kver = res_kernel.stdout.strip()
            # Parse major.minor
            m = re.match(r"^(\d+)\.(\d+)", kver)
            if m:
                major, minor = int(m.group(1)), int(m.group(2))
                if (major < 7) or (major == 7 and minor < 2):
                    print(Colors.colorize(f"HINWEIS / WARNUNG: Kernel {kver} erkannt. Die Recherche empfiehlt Kernel 7.2+ für optimale rtw89 6-GHz-Stabilität.", Colors.YELLOW))

        # 3. Game-devices-udev check
        res_udev = self.executor.run_cmd(["pacman", "-Q", "game-devices-udev"], simulate_in_dry_run=True)
        if res_udev.returncode != 0:
            print(Colors.colorize("HINWEIS: Paket 'game-devices-udev' ist nicht installiert. (Unter CachyOS für VR-Controller-udev-Rechte empfohlen).", Colors.YELLOW))

        # 4. NetworkManager service check
        res_nm = self.executor.run_cmd(["systemctl", "is-active", "NetworkManager"], simulate_in_dry_run=True)
        if res_nm.returncode != 0 or res_nm.stdout.strip() != "active":
            status_str = res_nm.stdout.strip() or "inaktiv / nicht installiert"
            print(Colors.colorize(
                f"HINWEIS / WARNUNG: NetworkManager-Dienststatus ist '{status_str}'.\n"
                "SteamVR und der Steam Frame Dongle setzen NetworkManager zwingend voraus,\n"
                "um die P2P-Verbindung zum Headset aufzubauen (reines systemd-networkd reicht nicht aus).\n"
                "Falls nötig, aktivieren Sie NetworkManager mit: sudo systemctl enable --now NetworkManager",
                Colors.YELLOW,
            ))

    def apply(self, args: argparse.Namespace) -> int:
        """Executes the full apply workflow."""
        self.pre_checks()

        print(Colors.colorize(f"\n=== Starte steamframe-setup (Version {VERSION}) ===", Colors.BOLD))
        if self.executor.dry_run:
            print(Colors.colorize(">>> DRY-RUN MODUS: Keine Änderungen werden auf das System angewendet <<<", Colors.YELLOW))

        # 1. Dongle detection
        interactive = not args.yes
        dongle = self.detector.find_dongle(requested_iface=args.iface, interactive=interactive)
        iface_name = dongle.iface if dongle else None

        if dongle:
            print(Colors.colorize(f"Dongle-Schnittstelle erkannt: {dongle.iface} (Treiber: {dongle.driver}, Bus: {dongle.bus})", Colors.GREEN))
        else:
            print(Colors.colorize("Kein rtw89-Dongle verbunden. Schnittstellen-unabhängige Anpassungen werden durchgeführt.", Colors.YELLOW))
            if args.ufw_scope == "iface":
                print(Colors.colorize("Hinweis: UFW-Scope 'iface' erfordert eine Schnittstelle. Verwenden Sie ggf. '--ufw-scope all' oder stecken Sie den Dongle ein.", Colors.YELLOW))

        # Summary of planned actions
        country = args.country.upper()
        print("\nGeplante Anpassungen:")
        print(f"  • Regulatorische Domäne: '{country}' (persistent & laufend, Fallbacks für cfg80211)")
        print(f"  • Firewall: UFW VRLink-Ports (Scope: {args.ufw_scope})")
        print("  • Latenz & Powersave: NM-Powersave aus, NM-Dispatcher für Scan-Unterdrückung")
        print("  • USB- & Kernel-Tuning: USB-Autosuspend aus (28de:2432), rtw89 Core-PS aus, 32MB Socket-Puffer, Polkit NM-Rechte")
        print("  • Valve Holo Toggles: Low-Latency-Treiberoptimierungen (HW_SCAN aus, A-MSDU aus, EDCA aggressiv) & Polkit-Rechte")
        print("  • Steam-Launcher: Wrapper (~/.local/bin/steam-frame mit PipeWire-Latenzfix) und Desktop-Datei")

        if not args.yes and not self.executor.dry_run:
            try:
                confirm = input("\nMöchten Sie diese Anpassungen anwenden? [j/N]: ").strip().lower()
                if confirm not in ("j", "ja", "y", "yes"):
                    print("Abgebrochen durch Benutzer.")
                    return 0
            except (KeyboardInterrupt, EOFError):
                sys.exit(1)

        # Load or initialize manifest
        manifest_data = self.manifest_mgr.load_manifest()
        if not manifest_data:
            manifest_data = {
                "version": VERSION,
                "created_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
                "country": country,
                "iface": iface_name,
                "ufw_scope": args.ufw_scope,
                "created_files": [],
                "modified_files": {},
                "ufw_rules": [],
                "installed_packages": [],
                "previous_state": {},
            }

        # Step 2: Package check
        self.regdom.check_and_install_package(
            auto_yes=args.yes,
            interactive=interactive,
            manifest_mgr=self.manifest_mgr,
            manifest_data=manifest_data,
        )

        # Step 3: Regdom
        print(Colors.colorize("\n[1/6] Konfiguriere Regulatorische Domäne...", Colors.BLUE))
        reg_actions = self.regdom.apply_regdom(country, self.manifest_mgr, manifest_data)
        for act in reg_actions:
            print(f"  ✓ {act}")

        # Step 4: Firewall
        print(Colors.colorize("\n[2/6] Konfiguriere Firewall (UFW)...", Colors.BLUE))
        fw_actions = self.firewall.apply_rules(args.ufw_scope, iface_name, self.manifest_mgr, manifest_data)
        for act in fw_actions:
            print(f"  ✓ {act}")
        if not fw_actions:
            print("  (Keine neuen UFW-Regeln erforderlich oder UFW inaktiv)")

        # Step 5: Latency & Powersave
        print(Colors.colorize("\n[3/6] Optimiere Latenz & Powersave...", Colors.BLUE))
        lat_actions = self.latency.apply_latency_tweaks(iface_name, self.manifest_mgr, manifest_data)
        for act in lat_actions:
            print(f"  ✓ {act}")

        # Step 6: System Tuning (USB power, rtw89 core PS, sysctl socket buffers, polkit, ananicy)
        print(Colors.colorize("\n[4/6] Optimiere USB-Power, Netzwerk-Socket-Puffer & Polkit...", Colors.BLUE))
        tune_actions = self.tuning.apply_all(self.manifest_mgr, manifest_data)
        for act in tune_actions:
            print(f"  ✓ {act}")

        # Step 7: Valve Holo Low-Latency Toggles
        print(Colors.colorize("\n[5/6] Installiere Valve Holo Realtek Low-Latency Toggles & Polkit...", Colors.BLUE))
        holo_actions = self.holo.apply(self.manifest_mgr, manifest_data)
        for act in holo_actions:
            print(f"  ✓ {act}")

        # Step 8: Steam Launcher
        print(Colors.colorize("\n[6/6] Erstelle Steam-Launcher...", Colors.BLUE))
        steam_actions = self.steam.apply_steam_wrapper(self.manifest_mgr, manifest_data)
        for act in steam_actions:
            print(f"  ✓ {act}")

        # Save manifest
        self.manifest_mgr.save_manifest(manifest_data)
        print(Colors.colorize(f"\nManifest erfolgreich gespeichert: {self.manifest_mgr.manifest_path}", Colors.GREEN))

        # Checklist
        self.print_checklist()
        print(Colors.colorize("Einrichtung abgeschlossen! Rückgängigmachen jederzeit mit: sudo steamframe-setup undo\n", Colors.BOLD))
        return 0

    def undo(self, args: argparse.Namespace) -> int:
        """Rolls back all changes exactly based on manifest."""
        manifest_data = self.manifest_mgr.load_manifest()

        if not manifest_data:
            print(Colors.colorize(f"Kein Manifest unter '{self.manifest_mgr.manifest_path}' gefunden. Es wurden noch keine Änderungen durch dieses Tool angewendet.", Colors.YELLOW))
            return 0

        if os.geteuid() != 0 and self.executor.root == Path("/") and not self.executor.dry_run:
            print(Colors.colorize("FEHLER: 'steamframe-setup undo' benötigt Root-Rechte (bitte mit 'sudo steamframe-setup undo' ausführen).", Colors.RED))
            sys.exit(1)

        print(Colors.colorize(f"\n=== Starte steamframe-setup undo (Version {VERSION}) ===", Colors.BOLD))
        if self.executor.dry_run:
            print(Colors.colorize(">>> DRY-RUN MODUS: Keine Änderungen werden physisch rückgängig gemacht <<<", Colors.YELLOW))

        created_files = manifest_data.get("created_files", [])
        modified_files = manifest_data.get("modified_files", {})
        ufw_rules = manifest_data.get("ufw_rules", [])
        installed_packages = manifest_data.get("installed_packages", [])

        print("\nFolgende Änderungen werden exakt zurückgesetzt:")
        print(f"  • {len(ufw_rules)} UFW-Regeln entfernen")
        print(f"  • {len(modified_files)} geänderte Dateien aus Backup wiederherstellen")
        print(f"  • {len(created_files)} erstellte Dateien / Units löschen")
        if installed_packages:
            print(f"  • Installierte Pakete: {', '.join(installed_packages)}")

        if not args.yes and not self.executor.dry_run:
            try:
                ans = input("\nMöchten Sie alle Änderungen jetzt zurücksetzen? [j/N]: ").strip().lower()
                if ans not in ("j", "ja", "y", "yes"):
                    print("Abgebrochen durch Benutzer.")
                    return 0
            except (KeyboardInterrupt, EOFError):
                sys.exit(1)

        # 0. Revert Holo low-latency settings
        holo_reverted = self.holo.revert(manifest_data)
        for hr in holo_reverted:
            print(f"  ✓ {hr}")

        # 1. Revert UFW rules
        print(Colors.colorize("\n[1/5] Setze UFW-Regeln zurück...", Colors.BLUE))
        fw_reverted = self.firewall.revert_rules(manifest_data)
        for r in fw_reverted:
            print(f"  ✓ {r}")

        # 2. Revert modified files
        print(Colors.colorize("\n[2/5] Stelle geänderte Dateien aus Backups wieder her...", Colors.BLUE))
        for file_str, meta in modified_files.items():
            target_file = Path(file_str)
            backup_path_str = meta.get("backup_path")
            existed_before = meta.get("existed_before", True)

            if not existed_before:
                if target_file.exists():
                    self.executor.remove_file(target_file)
                    print(f"  ✓ {target_file} gelöscht (existierte vor apply nicht)")
            elif backup_path_str:
                backup_file = Path(backup_path_str)
                if backup_file.exists():
                    if not self.executor.dry_run:
                        shutil.copy2(backup_file, target_file)
                    print(f"  ✓ {target_file} aus Backup {backup_file.name} wiederhergestellt")
                else:
                    print(Colors.colorize(f"  ! Backup-Datei {backup_path_str} nicht gefunden (übersprungen)", Colors.YELLOW))

        # 3. Remove created files
        print(Colors.colorize("\n[3/5] Lösche vom Tool erstellte Dateien & Units...", Colors.BLUE))
        for file_str in created_files:
            target_file = Path(file_str)
            if target_file.exists():
                self.executor.remove_file(target_file)
                print(f"  ✓ Gelöscht: {target_file}")
            else:
                print(f"  - {target_file} existiert bereits nicht mehr (übersprungen)")

        # 4. Revert Regdom & reload services
        print(Colors.colorize("\n[4/5] Setze Regdom zurück und lade Dienste neu...", Colors.BLUE))
        reg_reverted = self.regdom.revert_regdom(manifest_data)
        for r in reg_reverted:
            print(f"  ✓ {r}")

        # Reload NetworkManager if NM config was deleted
        if not self.executor.dry_run and self.executor.root == Path("/"):
            self.executor.run_cmd(["nmcli", "general", "reload", "conf"])
            print("  ✓ NetworkManager-Konfiguration neu geladen")

        # Reload udev, sysctl, and ananicy after files were deleted
        self.tuning.reload_subsystems_after_undo()

        # 5. Handle installed packages
        print(Colors.colorize("\n[5/5] Behandle installierte Pakete...", Colors.BLUE))
        for pkg in installed_packages:
            remove_pkg = args.remove_packages
            if not remove_pkg and not args.yes and not self.executor.dry_run:
                try:
                    q = input(f"Soll das durch das Tool installierte Paket '{pkg}' deinstalliert werden? [j/N]: ").strip().lower()
                    if q in ("j", "ja", "y", "yes"):
                        remove_pkg = True
                except (KeyboardInterrupt, EOFError):
                    pass

            if remove_pkg:
                res_rm = self.executor.run_cmd(["pacman", "-R", "--noconfirm", pkg])
                if res_rm.success:
                    print(Colors.colorize(f"  ✓ Paket '{pkg}' erfolgreich deinstalliert.", Colors.GREEN))
                else:
                    print(Colors.colorize(f"  ! Konnte '{pkg}' nicht deinstallieren: {res_rm.stderr.strip()}", Colors.YELLOW))
            else:
                print(f"  - Paket '{pkg}' wurde beibehalten.")

        # Clean up manifest
        self.manifest_mgr.remove_manifest_and_backups()
        print(Colors.colorize("\nManifest und Backup-Dateien wurden vollständig bereinigt.", Colors.GREEN))
        print(Colors.colorize("Undo erfolgreich abgeschlossen: System ist wieder im Ursprungszustand!\n", Colors.BOLD))
        return 0

    def status(self, args: argparse.Namespace) -> int:
        """Inspects and reports system status and applied tweaks."""
        items: List[CheckItem] = []

        # 1. Kernel & rtw89 Module
        res_kernel = self.executor.run_cmd(["uname", "-r"], simulate_in_dry_run=True)
        kver = res_kernel.stdout.strip()
        k_status = "OK"
        k_msg = f"Kernel {kver}"
        m = re.match(r"^(\d+)\.(\d+)", kver)
        if m and ((int(m.group(1)) < 7) or (int(m.group(1)) == 7 and int(m.group(2)) < 2)):
            k_status = "WARN"
            k_msg += " (Recherche empfiehlt 7.2+)"
        items.append(CheckItem("System", "Kernel-Version", k_status, k_msg))

        # Check rtw89 kernel driver presence
        res_mod = self.executor.run_cmd(["modinfo", "rtw89_core"], simulate_in_dry_run=True)
        if res_mod.returncode == 0:
            items.append(CheckItem("System", "rtw89-Treiber-Modul", "OK", "Im Kernel vorhanden"))
        else:
            items.append(CheckItem("System", "rtw89-Treiber-Modul", "WARN", "Modul 'rtw89_core' nicht gefunden"))

        # game-devices-udev
        res_udev = self.executor.run_cmd(["pacman", "-Q", "game-devices-udev"], simulate_in_dry_run=True)
        if res_udev.returncode == 0:
            items.append(CheckItem("System", "game-devices-udev", "OK", "Installiert"))
        else:
            items.append(CheckItem("System", "game-devices-udev", "WARN", "Nicht installiert (optional für CachyOS)"))

        # 2. Dongle Interface
        all_ifaces = self.detector.scan_interfaces()
        dongle = self.detector.find_dongle(requested_iface=args.iface, interactive=False)
        if dongle:
            items.append(CheckItem("Dongle", "Schnittstelle", "OK", f"{dongle.iface} (Treiber: {dongle.driver}, Bus: {dongle.bus})"))

            # Check powersave runtime
            res_ps = self.executor.run_cmd(["iw", "dev", dongle.iface, "get", "power_save"], simulate_in_dry_run=True)
            if "Power save: off" in res_ps.stdout:
                items.append(CheckItem("Dongle", "Wi-Fi Powersave", "OK", "Deaktiviert (optimal)"))
            elif "Power save: on" in res_ps.stdout:
                items.append(CheckItem("Dongle", "Wi-Fi Powersave", "WARN", "Aktiv (verursacht Latenzspitzen!)"))
            else:
                items.append(CheckItem("Dongle", "Wi-Fi Powersave", "WARN", "Konnte nicht ermittelt werden"))
        else:
            items.append(CheckItem("Dongle", "Schnittstelle", "WARN", "Kein rtw89-Dongle angeschlossen"))

        # 3. Regulatory Domain
        res_regpkg = self.executor.run_cmd(["pacman", "-Q", "wireless-regdb"], simulate_in_dry_run=True)
        if res_regpkg.returncode == 0:
            items.append(CheckItem("Regdom", "Paket wireless-regdb", "OK", "Installiert"))
        else:
            items.append(CheckItem("Regdom", "Paket wireless-regdb", "WARN", "Fehlt (6 GHz evtl. gesperrt)"))

        reg_conf = self.executor.resolve_path(REGDOM_CONF_REL)
        if reg_conf.exists():
            text = reg_conf.read_text(encoding="utf-8")
            m_reg = re.search(r'^\s*WIRELESS_REGDOM="?([A-Z0-9]+)"?', text, re.MULTILINE)
            if m_reg:
                items.append(CheckItem("Regdom", "conf.d/wireless-regdom", "OK", f"Gesetzt auf {m_reg.group(1)}"))
            else:
                items.append(CheckItem("Regdom", "conf.d/wireless-regdom", "UNAPPLIED", "Nicht konfiguriert"))
        else:
            items.append(CheckItem("Regdom", "conf.d/wireless-regdom", "UNAPPLIED", "Datei existiert nicht"))

        country, reg_output = self.regdom.get_current_regdom()
        is_6g = self.regdom.check_6ghz_active(reg_output)
        items.append(CheckItem("Regdom", "Laufzeit-Regdom", "OK" if country != "00" else "WARN", f"Global: {country}"))
        items.append(CheckItem("Regdom", "6-GHz-Frequenzbereich", "OK" if is_6g else "WARN", "Aktiv (5945-6425 MHz)" if is_6g else "Inaktiv oder gedrosselt"))

        self_phys = self.regdom.has_self_managed_phys(reg_output)
        if self_phys:
            items.append(CheckItem("Regdom", "Self-Managed PHYs", "WARN", f"{', '.join(self_phys)} (Hardware-Regeln aktiv)"))

        # 4. Firewall (UFW)
        fw_type = self.firewall.detect_active_firewall()
        items.append(CheckItem("Firewall", "Aktiver Dienst", "OK" if fw_type == "ufw" else "INFO", f"Erkannt: {fw_type}"))

        if fw_type == "ufw":
            rules = self.firewall.get_existing_ufw_rules()
            missing_ports = []
            for p in VRLINK_PORTS:
                if not self.firewall.is_rule_present(p["port"], p["proto"], "all", None, rules):
                    missing_ports.append(f"{p['port']}/{p['proto']}")
            if not missing_ports:
                items.append(CheckItem("Firewall", "VRLink-Portfreigaben", "OK", "Alle Ports in UFW erlaubt"))
            else:
                items.append(CheckItem("Firewall", "VRLink-Portfreigaben", "UNAPPLIED", f"Fehlende Ports: {', '.join(missing_ports)}"))

        # 5. NetworkManager & Latency
        res_nm = self.executor.run_cmd(["systemctl", "is-active", "NetworkManager"], simulate_in_dry_run=True)
        nm_active = (res_nm.returncode == 0 and res_nm.stdout.strip() == "active")
        items.append(CheckItem(
            "Latenz",
            "NetworkManager-Dienst",
            "OK" if nm_active else "WARN",
            "Aktiv (erforderlich für P2P-Link)" if nm_active else f"Inaktiv ({res_nm.stdout.strip() or 'nicht gestartet'})",
        ))

        nm_conf = self.executor.resolve_path(NM_CONF_REL)
        items.append(CheckItem("Latenz", "NM-Powersave-Konfiguration", "OK" if nm_conf.exists() else "UNAPPLIED", "Vorhanden" if nm_conf.exists() else "Nicht vorhanden"))

        dispatcher = self.executor.resolve_path(NM_DISPATCHER_REL)
        items.append(CheckItem("Latenz", "NM-Dispatcher-Skript", "OK" if dispatcher.exists() else "UNAPPLIED", "Vorhanden" if dispatcher.exists() else "Nicht vorhanden"))

        # 6. System Tuning (USB & Kernel)
        items.append(CheckItem("Tuning", "USB-Autosuspend-Regel", "OK" if self.tuning.udev_path.exists() else "UNAPPLIED", "Vorhanden (28de:2432)" if self.tuning.udev_path.exists() else "Nicht vorhanden"))
        items.append(CheckItem("Tuning", "rtw89 Core-Powersave", "OK" if self.tuning.modprobe_path.exists() else "UNAPPLIED", "Deaktiviert (disable_ps_mode=y)" if self.tuning.modprobe_path.exists() else "Standard"))
        items.append(CheckItem("Tuning", "Sysctl-Netzwerkpuffer", "OK" if self.tuning.sysctl_path.exists() else "UNAPPLIED", "32MB Decke aktiv" if self.tuning.sysctl_path.exists() else "Standard"))
        items.append(CheckItem("Tuning", "Polkit NM-Regel", "OK" if self.tuning.polkit_path.exists() else "UNAPPLIED", "Vorhanden (P2P-Rechte)" if self.tuning.polkit_path.exists() else "Nicht vorhanden"))
        if self.tuning.ananicy_path.exists():
            items.append(CheckItem("Tuning", "Ananicy vrcompositor", "OK", "LowLatency_RT aktiv"))

        # 7. Valve Holo Firmware Toggles
        holo_inst = self.holo.is_installed()
        items.append(CheckItem("Holo-Treiber", "Valve Firmware-Toggles", "OK" if holo_inst else "UNAPPLIED", "Installiert (/usr/bin/holo-polkit-helpers/...)" if holo_inst else "Nicht installiert"))
        items.append(CheckItem("Holo-Treiber", "Polkit-Berechtigung", "OK" if self.holo.policy_path.exists() else "UNAPPLIED", "Vorhanden (passwortfreies Umschalten)" if self.holo.policy_path.exists() else "Nicht vorhanden"))

        # 8. Steam Launcher
        has_native, has_flatpak = self.steam.check_steam_environment()
        if has_native:
            items.append(CheckItem("Steam", "Installationstyp", "OK", "Natives Steam (/usr/bin/steam)"))
        elif has_flatpak:
            items.append(CheckItem("Steam", "Installationstyp", "WARN", "Flatpak erkannt (nicht empfohlen!)"))
        else:
            items.append(CheckItem("Steam", "Installationstyp", "WARN", "Kein Steam gefunden"))

        _, user_home, _, _ = get_target_user(self.executor)
        wrapper = user_home / ".local" / "bin" / "steam-frame"
        desktop = user_home / ".local" / "share" / "applications" / "steam-frame.desktop"
        items.append(CheckItem("Steam", "Wrapper-Skript", "OK" if wrapper.exists() else "UNAPPLIED", str(wrapper) if wrapper.exists() else "Nicht vorhanden"))
        items.append(CheckItem("Steam", "Desktop-Eintrag", "OK" if desktop.exists() else "UNAPPLIED", str(desktop) if desktop.exists() else "Nicht vorhanden"))

        # 8. Manifest
        manifest = self.manifest_mgr.load_manifest()
        if manifest:
            items.append(CheckItem("Manifest", "Setup-Status", "OK", f"Angewendet am {manifest.get('created_at', '?')}"))
        else:
            items.append(CheckItem("Manifest", "Setup-Status", "UNAPPLIED", "Nicht angewendet (kein Manifest)"))

        # Print formatted table
        print(f"\n{Colors.BOLD}{Colors.CYAN}=== Status & Diagnose: Valve Steam Frame / VRLink ==={Colors.RESET}\n")
        current_cat = ""
        for item in items:
            if item.category != current_cat:
                current_cat = item.category
                print(f"{Colors.BOLD}--- {current_cat} ---{Colors.RESET}")

            if item.status == "OK":
                tag = Colors.colorize("[  ANGEWENDET  ]", Colors.GREEN)
            elif item.status == "WARN":
                tag = Colors.colorize("[   WARNUNG    ]", Colors.YELLOW)
            elif item.status == "UNAPPLIED":
                tag = Colors.colorize("[NICHT ANGEWANDT]", Colors.DIM)
            elif item.status == "DIVERGENT":
                tag = Colors.colorize("[  ABWEICHEND  ]", Colors.RED)
            else:
                tag = Colors.colorize(f"[{item.status:^14}]", Colors.BLUE)

            print(f"  {tag} {item.name:<28} : {item.message}")
        print()
        return 0

    def reset_steam(self) -> int:
        """Kills all running and lingering Steam, SteamVR, and compositor processes."""
        print(Colors.colorize("\n=== Beende alle laufenden Steam- und SteamVR-Prozesse ===", Colors.BOLD))
        targets = ["steam", "steamvr", "vrserver", "vrcompositor", "vrmonitor", "vrwebhelper"]
        killed = []
        for proc in targets:
            res_pgrep = self.executor.run_cmd(["pgrep", "-x", proc], simulate_in_dry_run=True)
            if res_pgrep.returncode == 0:
                self.executor.run_cmd(["pkill", "-9", "-x", proc])
                killed.append(proc)

        if killed:
            print(Colors.colorize(f"  ✓ Folgende Prozesse wurden beendet: {', '.join(killed)}", Colors.GREEN))
        else:
            print("  (Keine aktiven Steam- oder SteamVR-Prozesse gefunden)")
        print(Colors.colorize("Bereinigung abgeschlossen. Steam kann nun sauber neu gestartet werden.\n", Colors.BOLD))
        return 0

# ==============================================================================
# Logging Setup
# ==============================================================================

def setup_logging(executor: SystemExecutor) -> None:
    """Configures structured file logging and console handler."""
    log_path = executor.resolve_path(LOG_REL_PATH)
    logger = logging.getLogger(TOOL_NAME)
    logger.setLevel(logging.DEBUG)

    # File handler
    try:
        log_path.parent.mkdir(parents=True, exist_ok=True)
        fh = logging.FileHandler(log_path, encoding="utf-8")
        fh.setLevel(logging.DEBUG)
        fmt = logging.Formatter("%(asctime)s [%(levelname)s] %(name)s: %(message)s")
        fh.setFormatter(fmt)
        logger.addHandler(fh)
    except Exception as e:
        # Fallback to temp file if permission denied on /var/log/
        try:
            tmp_log = Path("/tmp/steamframe-setup.log")
            fh = logging.FileHandler(tmp_log, encoding="utf-8")
            fh.setLevel(logging.DEBUG)
            fmt = logging.Formatter("%(asctime)s [%(levelname)s] %(name)s: %(message)s")
            fh.setFormatter(fmt)
            logger.addHandler(fh)
        except Exception:
            pass

# ==============================================================================
# CLI Argument Parser & Entry Point
# ==============================================================================

def build_parser() -> argparse.ArgumentParser:
    # Common options that apply to all subcommands
    common_parser = argparse.ArgumentParser(add_help=False)
    common_parser.add_argument("--dry-run", action="store_true", help="Simuliert alle Aktionen, ohne Dateien zu schreiben oder Befehle auszuführen.")
    common_parser.add_argument("--iface", type=str, default=None, help="Name der Dongle-WLAN-Schnittstelle (z.B. wlan1). Wird sonst automatisch ermittelt.")
    common_parser.add_argument("--country", type=str, default=DEFAULT_COUNTRY, help=f"2-stelliger Ländercode für die Regulatorische Domäne (Standard: {DEFAULT_COUNTRY}).")
    common_parser.add_argument("--ufw-scope", choices=["iface", "all"], default="iface", help="Scope der UFW-Regeln: 'iface' (Standard, nur auf Dongle-Interface) oder 'all'.")
    common_parser.add_argument("-y", "--yes", action="store_true", help="Automatische Bestätigung aller Sicherheitsabfragen (nicht-interaktiver Modus).")
    common_parser.add_argument("--root", type=str, default="/", help="Basisverzeichnis für Datei- und Systemoperationen (Standard: /, nützlich für Tests).")

    parser = argparse.ArgumentParser(
        prog=TOOL_NAME,
        description="Automatisiertes Setup & sauberes Undo aller Systemanpassungen für den Valve Steam Frame Dongle auf CachyOS.",
        parents=[common_parser],
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")

    subparsers = parser.add_subparsers(dest="command", required=True, help="Auszuführendes Kommando")

    # apply
    subparsers.add_parser(
        "apply",
        parents=[common_parser],
        help="Wendet alle Systemanpassungen für Steam Frame / VRLink an.",
    )

    # undo
    parser_undo = subparsers.add_parser(
        "undo",
        parents=[common_parser],
        help="Nimmt alle durch das Tool vorgenommenen Änderungen exakt zurück.",
    )
    parser_undo.add_argument("--remove-packages", action="store_true", help="Entfernt auch durch das Tool installierte Pakete (z.B. wireless-regdb).")

    # status
    subparsers.add_parser(
        "status",
        parents=[common_parser],
        help="Zeigt den aktuellen Zustand aller Anpassungen an.",
    )

    # check
    subparsers.add_parser(
        "check",
        parents=[common_parser],
        help="Alias für 'status' mit detaillierter Validierung.",
    )

    # reset-steam
    subparsers.add_parser(
        "reset-steam",
        parents=[common_parser],
        help="Beendet alle hängenden Steam- und SteamVR-Prozesse (vrserver, vrcompositor, steam).",
    )

    return parser

def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    root_path = Path(args.root).resolve()
    executor = SystemExecutor(dry_run=args.dry_run, root=root_path)
    setup_logging(executor)

    engine = SetupEngine(executor)

    if args.command == "apply":
        return engine.apply(args)
    elif args.command == "undo":
        return engine.undo(args)
    elif args.command in ("status", "check"):
        return engine.status(args)
    elif args.command == "reset-steam":
        return engine.reset_steam()
    else:
        parser.print_help()
        return 1

if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nAbgebrochen durch Benutzer.")
        sys.exit(130)
