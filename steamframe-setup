class RegdomManager:
    """Configures wireless regulatory domain (DE / 6 GHz) persistently and safely."""

    def __init__(self, executor: SystemExecutor):
        self.executor = executor

    def check_and_install_package(
        self,
        auto_yes: bool,
        interactive: bool,
        manifest_mgr: ManifestManager,
        manifest_data: Dict[str, Any],
    ) -> bool:
        """Verifies wireless-regdb is installed; prompts to install via pacman if missing."""
        res = self.executor.run_cmd(["pacman", "-Q", "wireless-regdb"], simulate_in_dry_run=True)
        if res.returncode == 0:
            return True

        print(Colors.colorize("Paket 'wireless-regdb' fehlt. Es ist zwingend erforderlich für 6-GHz-Support.", Colors.YELLOW))

        if not auto_yes:
            if not interactive:
                print(Colors.colorize("Installation abgebrochen: Nicht-interaktiver Modus ohne --yes.", Colors.RED))
                return False
            try:
                ans = input("Möchten Sie 'wireless-regdb' jetzt via pacman installieren? [j/N]: ").strip().lower()
                if ans not in ("j", "ja", "y", "yes"):
                    print(Colors.colorize("Installation übersprungen.", Colors.YELLOW))
                    return False
            except (KeyboardInterrupt, EOFError):
                sys.exit(1)

        res_install = self.executor.run_cmd(["pacman", "-S", "--needed", "--noconfirm", "wireless-regdb"])
        if res_install.success:
            manifest_mgr.record_installed_package("wireless-regdb", manifest_data)
            print(Colors.colorize("Paket 'wireless-regdb' erfolgreich installiert.", Colors.GREEN))
            return True
        else:
            print(Colors.colorize(f"Fehler bei Installation von 'wireless-regdb': {res_install.stderr}", Colors.RED))
            return False

    def get_current_regdom(self) -> Tuple[str, str]:
        """
        Parses `iw reg get` to return (global_country, full_output).
        """
        res = self.executor.run_cmd(["iw", "reg", "get"], simulate_in_dry_run=True)
        if res.returncode != 0:
            return "UNKNOWN", res.stderr

        output = res.stdout
        country = "UNKNOWN"
        match = re.search(r"country\s+([A-Z0-9]{2}):", output)
        if match:
            country = match.group(1)
        return country, output

    def check_6ghz_active(self, reg_output: str) -> bool:
        """
        Checks if 6-GHz band (5945-6425 MHz) is enabled in regdom output without DISABLED.
        """
        # Pattern for 6 GHz range: 5945 - 6425
        match = re.search(r"\(\s*5945\s*-\s*6425[^)]*\),\s*\([^)]*\)", reg_output)
        if match:
            line = match.group(0)
            return "DISABLED" not in line
        return False

    def has_self_managed_phys(self, reg_output: str) -> List[str]:
        """Finds any self-managed PHYs in iw reg get output."""
        return re.findall(r"(phy#\d+)\s*\(self-managed\)", reg_output)

    def apply_regdom(
        self,
        country: str,
        manifest_mgr: ManifestManager,
        manifest_data: Dict[str, Any],
    ) -> List[str]:
        """Sets persistent and runtime regulatory domain to country."""
        actions: List[str] = []

        curr_country, curr_output = self.get_current_regdom()
        prev_state = manifest_data.setdefault("previous_state", {})
        if "regdom" not in prev_state:
            prev_state["regdom"] = curr_country

        # 1. Update /etc/conf.d/wireless-regdom
        conf_path = self.executor.resolve_path(REGDOM_CONF_REL)
        manifest_mgr.backup_file(conf_path, manifest_data)

        target_line = f'WIRELESS_REGDOM="{country}"\n'
        if conf_path.exists():
            original_text = conf_path.read_text(encoding="utf-8")
            if re.search(r"^\s*WIRELESS_REGDOM=", original_text, re.MULTILINE):
                new_text = re.sub(
                    r"^\s*WIRELESS_REGDOM=.*$",
                    f'WIRELESS_REGDOM="{country}"',
                    original_text,
                    flags=re.MULTILINE,
                )
            else:
                new_text = original_text + "\n" + target_line
        else:
            new_text = f"# Erstellt von {TOOL_NAME}\n{target_line}"

        self.executor.write_file(conf_path, new_text)
        actions.append(f"Konfigurationsdatei aktualisiert: {conf_path} (WIRELESS_REGDOM=\"{country}\")")

        # 2. Modprobe fallback: /etc/modprobe.d/steamframe-regdom.conf
        modprobe_path = self.executor.resolve_path(MODPROBE_CONF_REL)
        manifest_mgr.record_created_file(modprobe_path, manifest_data)
        modprobe_content = (
            f"# Erstellt von {TOOL_NAME}\n"
            f"# Persistente Zuweisung des Regdoms fuer cfg80211\n"
            f"options cfg80211 ieee80211_regdom={country}\n"
        )
        self.executor.write_file(modprobe_path, modprobe_content)
        actions.append(f"Modprobe-Fallback angelegt: {modprobe_path}")

        # 3. Systemd oneshot unit fallback
        systemd_path = self.executor.resolve_path(SYSTEMD_UNIT_REL)
        manifest_mgr.record_created_file(systemd_path, manifest_data)
        unit_content = (
            f"[Unit]\n"
            f"Description=SteamFrame Wireless Regulatory Domain ({country})\n"
            f"After=network-pre.target\n"
            f"Wants=network-pre.target\n\n"
            f"[Service]\n"
            f"Type=oneshot\n"
            f"RemainAfterExit=yes\n"
            f"ExecStart=/usr/bin/iw reg set {country}\n\n"
            f"[Install]\n"
            f"WantedBy=multi-user.target\n"
        )
        self.executor.write_file(systemd_path, unit_content)
        # Enable unit via systemctl if real root
        if not self.executor.dry_run and self.executor.root == Path("/"):
            self.executor.run_cmd(["systemctl", "daemon-reload"])
            self.executor.run_cmd(["systemctl", "enable", "steamframe-regdom.service"])
        actions.append(f"Systemd-Unit angelegt und aktiviert: {systemd_path}")

        # 4. Runtime apply
        res_iw = self.executor.run_cmd(["iw", "reg", "set", country])
        if res_iw.success:
            actions.append(f"Laufzeit-Regdom gesetzt: 'iw reg set {country}'")
        else:
            actions.append(f"Hinweis: 'iw reg set {country}' meldete: {res_iw.stderr.strip()}")

        # 5. Verification
        new_country, new_output = self.get_current_regdom()
        if new_country == country:
            actions.append(f"Verifikation: Globaler Regdom ist jetzt '{country}'.")
        else:
            actions.append(f"Warnung: Regdom nach Setzen meldet '{new_country}' statt '{country}'.")

        if self.check_6ghz_active(new_output):
            actions.append("Verifikation: 6-GHz-Frequenzbereich (5945-6425 MHz) ist aktiv!")
        else:
            actions.append("Warnung: 6-GHz-Frequenzbereich ist in iw reg get nicht aktiv.")

        self_phys = self.has_self_managed_phys(new_output)
        if self_phys:
            actions.append(f"Hinweis: Gefundene self-managed PHYs: {', '.join(self_phys)} (Hardware steuert Bänder autonom).")

        return actions

    def revert_regdom(self, manifest_data: Dict[str, Any]) -> List[str]:
        """Reverts regdom files and sets previous regdom."""
        reverted: List[str] = []

        # Disable systemd service
        if not self.executor.dry_run and self.executor.root == Path("/"):
            self.executor.run_cmd(["systemctl", "disable", "--now", "steamframe-regdom.service"])
            self.executor.run_cmd(["systemctl", "daemon-reload"])

        # Revert runtime regdom
        prev_country = manifest_data.get("previous_state", {}).get("regdom", "00")
        if prev_country and prev_country != "UNKNOWN":
            res_iw = self.executor.run_cmd(["iw", "reg", "set", prev_country])
            if res_iw.success:
                reverted.append(f"Laufzeit-Regdom zurückgesetzt auf '{prev_country}'")

        return reverted

