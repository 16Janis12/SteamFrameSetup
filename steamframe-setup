class LatencyManager:
    """Configures NetworkManager and Wi-Fi interface for low latency (no powersave, no bgscan)."""

    def __init__(self, executor: SystemExecutor):
        self.executor = executor

    def apply_latency_tweaks(
        self,
        iface: Optional[str],
        manifest_mgr: ManifestManager,
        manifest_data: Dict[str, Any],
    ) -> List[str]:
        """Applies persistent NetworkManager configs and runtime powersave disabling."""
        actions: List[str] = []

        # 1. NetworkManager configuration
        nm_conf_path = self.executor.resolve_path(NM_CONF_REL)
        manifest_mgr.record_created_file(nm_conf_path, manifest_data)

        # Match specific interface if known, otherwise match driver rtw89
        match_spec = f"interface-name:{iface}" if iface else "driver:rtw89*"
        nm_conf_content = (
            f"# Erstellt von {TOOL_NAME}\n"
            f"[connection-steamframe-powersave]\n"
            f"match-device={match_spec}\n"
            f"wifi.powersave=2\n"  # 2 = disable powersave in NetworkManager
        )
        self.executor.write_file(nm_conf_path, nm_conf_content)
        actions.append(f"NetworkManager-Powersave-Konfiguration erstellt: {nm_conf_path}")

        # 2. NetworkManager Dispatcher script
        dispatcher_path = self.executor.resolve_path(NM_DISPATCHER_REL)
        manifest_mgr.record_created_file(dispatcher_path, manifest_data)

        target_iface_str = iface or ""
        dispatcher_content = f"""#!/usr/bin/env bash
# Erstellt von {TOOL_NAME}
# Hotplug- und Verbindungs-Handler fuer Valve Steam Frame Dongle
IFACE="$1"
ACTION="$2"
TARGET_IFACE="{target_iface_str}"

case "$ACTION" in
    up|dhcp4-change|reapply)
        IS_MATCH=0
        if [ -n "$TARGET_IFACE" ] && [ "$IFACE" = "$TARGET_IFACE" ]; then
            IS_MATCH=1
        elif [ -e "/sys/class/net/$IFACE/device/driver" ]; then
            DRIVER=$(basename "$(readlink -f "/sys/class/net/$IFACE/device/driver" 2>/dev/null)" 2>/dev/null)
            case "$DRIVER" in
                rtw89*) IS_MATCH=1 ;;
            esac
        fi

        if [ "$IS_MATCH" -eq 1 ]; then
            # Powersave deaktivieren
            if command -v iw >/dev/null 2>&1; then
                iw dev "$IFACE" set power_save off 2>/dev/null || true
            fi

            # Valve Holo Low-Latency Toggles aktivieren (HW_SCAN aus, A-MSDU aus, EDCA aggressiv, MCS 0-9)
            if [ -x /usr/bin/holo-polkit-helpers/holo-realtek-firmware-toggles ]; then
                /usr/bin/holo-polkit-helpers/holo-realtek-firmware-toggles set-low-latency-mode on 2>/dev/null || true
            fi

            # wpa_cli bgscan Unterdrueckung versuchen (falls erreichbar)
            if command -v wpa_cli >/dev/null 2>&1; then
                wpa_cli -i "$IFACE" set_network 0 bgscan '""' 2>/dev/null || true
            fi
        fi
        ;;
    down)
        if [ -x /usr/bin/holo-polkit-helpers/holo-realtek-firmware-toggles ]; then
            /usr/bin/holo-polkit-helpers/holo-realtek-firmware-toggles reset 2>/dev/null || true
        fi
        ;;
esac
"""
        self.executor.write_file(dispatcher_path, dispatcher_content, mode=0o755)
        actions.append(f"NetworkManager-Dispatcher-Skript erstellt: {dispatcher_path}")

        # Reload NetworkManager conf
        if not self.executor.dry_run and self.executor.root == Path("/"):
            self.executor.run_cmd(["nmcli", "general", "reload", "conf"])
            actions.append("NetworkManager-Konfiguration neu geladen (nmcli general reload conf)")

        # 3. Runtime tweak if interface is currently present
        if iface:
            res_ps = self.executor.run_cmd(["iw", "dev", iface, "set", "power_save", "off"])
            if res_ps.success:
                actions.append(f"Laufzeit-Powersave für '{iface}' erfolgreich deaktiviert (iw dev {iface} set power_save off)")
            else:
                actions.append(f"Hinweis: Konnte Powersave für '{iface}' jetzt nicht setzen: {res_ps.stderr.strip()}")

            # Test wpa_cli reachability
            res_ping = self.executor.run_cmd(["wpa_cli", "-i", iface, "ping"])
            if res_ping.success and "PONG" in res_ping.stdout:
                res_bg = self.executor.run_cmd(["wpa_cli", "-i", iface, "set_network", "0", "bgscan", '""'])
                if res_bg.success:
                    actions.append(f"wpa_cli bgscan für '{iface}' erfolgreich deaktiviert.")
            else:
                actions.append(
                    f"Hinweis: wpa_cli Steuer-Interface für '{iface}' antwortet nicht (normal unter NetworkManager). "
                    "Scan-Unterdrückung wird zuverlässig über Dispatcher & Headset-BSSID gehandhabt."
                )

        return actions

