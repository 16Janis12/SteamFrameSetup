# System Tuning Manager (USB Power, Sysctl, Polkit, Ananicy)
# ==============================================================================

class SystemTuningManager:
    """Manages kernel, USB power, network socket buffer, and process scheduling tweaks."""

    def __init__(self, executor: SystemExecutor):
        self.executor = executor
        self.udev_path = executor.resolve_path(UDEV_USB_RULE_REL)
        self.modprobe_path = executor.resolve_path(MODPROBE_RTW89_REL)
        self.sysctl_path = executor.resolve_path(SYSCTL_NET_REL)
        self.polkit_path = executor.resolve_path(POLKIT_NM_REL)
        self.ananicy_path = executor.resolve_path(ANANICY_VR_REL)

    def apply_all(
        self,
        manifest_mgr: ManifestManager,
        manifest_data: Dict[str, Any],
    ) -> List[str]:
        actions: List[str] = []

        # 1. Udev rule for USB power (autosuspend off for Valve Dongle 28de:2432)
        manifest_mgr.record_created_file(self.udev_path, manifest_data)
        udev_content = (
            f"# Erstellt von {TOOL_NAME}\n"
            f"# Verhindert USB-Autosuspend fuer den Valve Steam Frame Dongle (28de:2432)\n"
            f'ACTION=="add|bind", SUBSYSTEM=="usb", ATTR{{idVendor}}=="28de", ATTR{{idProduct}}=="2432", '
            f'ATTR{{power/control}}="on", ATTR{{power/autosuspend}}="-1"\n'
        )
        self.executor.write_file(self.udev_path, udev_content, mode=0o644)
        actions.append(f"Udev-Regel fuer USB-Power angelegt: {self.udev_path}")

        if not self.executor.dry_run and self.executor.root == Path("/"):
            self.executor.run_cmd(["udevadm", "control", "--reload-rules"])
            self.executor.run_cmd(["udevadm", "trigger", "--subsystem-match=usb"])

        # 2. Kernel modprobe rtw89_core PM disable
        manifest_mgr.record_created_file(self.modprobe_path, manifest_data)
        modprobe_content = (
            f"# Erstellt von {TOOL_NAME}\n"
            f"# Deaktiviert Core-Powersave im Realtek rtw89-Treiber\n"
            f"options rtw89_core disable_ps_mode=y\n"
        )
        self.executor.write_file(self.modprobe_path, modprobe_content, mode=0o644)
        actions.append(f"Modprobe-Konfiguration fuer rtw89 angelegt: {self.modprobe_path}")

        # 3. Network socket buffers (sysctl)
        manifest_mgr.record_created_file(self.sysctl_path, manifest_data)
        sysctl_content = (
            f"# Erstellt von {TOOL_NAME}\n"
            f"# Erweiterte Socket-Puffer fuer unterbrechungsfreies 6-GHz-Streaming\n"
            f"net.core.rmem_max=33554432\n"
            f"net.core.wmem_max=33554432\n"
            f"net.core.rmem_default=524288\n"
            f"net.core.wmem_default=524288\n"
            f"net.core.optmem_max=2097152\n"
            f"-net.core.netdev_max_backlog=10000\n"
        )
        self.executor.write_file(self.sysctl_path, sysctl_content, mode=0o644)
        actions.append(f"Sysctl-Netzwerkpuffer-Konfiguration angelegt: {self.sysctl_path}")

        if not self.executor.dry_run and self.executor.root == Path("/"):
            self.executor.run_cmd(["sysctl", "--system"])

        # 4. Minimal Polkit rule for NetworkManager P2P pairing
        manifest_mgr.record_created_file(self.polkit_path, manifest_data)
        polkit_content = """// Erstellt von steamframe-setup
// Erlaubt Steam/VRLink im lokalen Nutzerkontext das Erstellen von P2P-Verbindungen
polkit.addRule(function(action, subject) {
    var allowed = [
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.wifi.share.protected"
    ];
    if (allowed.indexOf(action.id) !== -1 && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
"""
        self.executor.write_file(self.polkit_path, polkit_content, mode=0o644)
        actions.append(f"Polkit-Regel fuer NetworkManager angelegt: {self.polkit_path}")

        # 5. Ananicy-cpp process scheduling rules (if ananicy directory exists)
        ananicy_dir = self.executor.resolve_path("etc/ananicy.d")
        if ananicy_dir.exists() or (not self.executor.dry_run and self.executor.root != Path("/")):
            manifest_mgr.record_created_file(self.ananicy_path, manifest_data)
            ananicy_content = """[
  { "name": "vrcompositor", "type": "LowLatency_RT" },
  { "name": "vrcompositor-launcher", "type": "LowLatency_RT" }
]
"""
            self.executor.write_file(self.ananicy_path, ananicy_content, mode=0o644)
            actions.append(f"Ananicy-cpp-Regel fuer vrcompositor angelegt: {self.ananicy_path}")
            if not self.executor.dry_run and self.executor.root == Path("/"):
                self.executor.run_cmd(["systemctl", "try-restart", "ananicy-cpp"])

        return actions

    def reload_subsystems_after_undo(self) -> None:
        """Reloads udev, sysctl, and ananicy after files have been undone."""
        if not self.executor.dry_run and self.executor.root == Path("/"):
            self.executor.run_cmd(["udevadm", "control", "--reload-rules"])
            self.executor.run_cmd(["udevadm", "trigger", "--subsystem-match=usb"])
            self.executor.run_cmd(["sysctl", "--system"])
            self.executor.run_cmd(["systemctl", "try-restart", "ananicy-cpp"])

