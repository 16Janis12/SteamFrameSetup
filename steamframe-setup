class SteamManager:
    """Creates user-level Steam wrapper and desktop entry."""

    def __init__(self, executor: SystemExecutor):
        self.executor = executor

    def check_steam_environment(self) -> Tuple[bool, bool]:
        """
        Returns (has_native_steam, has_flatpak_steam).
        """
        has_native = self.executor.resolve_path("usr/bin/steam").exists()
        res_flatpak = self.executor.run_cmd(
            ["flatpak", "info", "com.valvesoftware.Steam"],
            simulate_in_dry_run=True,
        )
        has_flatpak = res_flatpak.returncode == 0
        return has_native, has_flatpak

    def apply_steam_wrapper(
        self,
        manifest_mgr: ManifestManager,
        manifest_data: Dict[str, Any],
    ) -> List[str]:
        """Creates ~/.local/bin/steam-frame and desktop file for $SUDO_USER."""
        actions: List[str] = []
        has_native, has_flatpak = self.check_steam_environment()

        if has_flatpak:
            print(
                Colors.colorize(
                    "WARNUNG: Steam wurde als Flatpak erkannt!\n"
                    "VRLink und der 32-Bit-Treiber-Watchdog funktionieren nur mit nativem Steam zuverlässig.\n"
                    "Empfehlung: Installieren Sie 'steam' nativ via pacman (multilib).",
                    Colors.YELLOW,
                )
            )

        username, user_home, uid, gid = get_target_user(self.executor)

        # 1. Wrapper Script
        wrapper_dir = user_home / ".local" / "bin"
        wrapper_path = wrapper_dir / "steam-frame"
        manifest_mgr.record_created_file(wrapper_path, manifest_data)

        wrapper_content = """#!/usr/bin/env bash
# Steam-Frame Launcher fuer Valve Steam Frame / VRLink
# Erzwingt PipeWire und VRLink-Treiber (Workaround fuer 32-Bit-Watchdog)
# PipeWire-Latenz auf 512 Samples @ 48kHz (10.66ms) festlegen gegen Audio-Knacken/Desync
export PIPEWIRE_LATENCY="512/48000"

# QT Wayland Workaround: Verhindert stillen Absturz der SteamVR-Oberflaeche unter Wayland (KDE Plasma, Sway, Hyprland, etc.)
export QT_QPA_PLATFORM="xcb"

exec steam -pipewire -vrlinkforceenable "$@"
"""
        self.executor.write_file(wrapper_path, wrapper_content, mode=0o755)

        # 2. Desktop Entry
        apps_dir = user_home / ".local" / "share" / "applications"
        desktop_path = apps_dir / "steam-frame.desktop"
        manifest_mgr.record_created_file(desktop_path, manifest_data)

        desktop_content = f"""[Desktop Entry]
Name=Steam (Frame / VRLink)
Comment=Steam mit PipeWire und erzwungenem VRLink starten
Exec={wrapper_path} %U
Icon=steam
Terminal=false
Type=Application
Categories=Game;Network;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
"""
        self.executor.write_file(desktop_path, desktop_content, mode=0o644)

        # Set user ownership if running on real filesystem as root
        if not self.executor.dry_run and os.geteuid() == 0:
            for p in (wrapper_path, desktop_path):
                try:
                    os.chown(p, uid, gid)
                except Exception as e:
                    self.executor.logger.warning(f"Could not chown {p} to {uid}:{gid}: {e}")

        actions.append(f"Benutzer-Wrapper erstellt: {wrapper_path}")
        actions.append(f"Desktop-Eintrag erstellt: {desktop_path} (Benutzer: {username})")
        return actions

