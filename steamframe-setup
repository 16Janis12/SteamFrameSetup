class HoloFirmwareManager:
    """Manages installation and execution of Valve's holo-realtek-firmware-toggles helper."""

    def __init__(self, executor: SystemExecutor):
        self.executor = executor
        self.bin_path = executor.resolve_path(HOLO_TOGGLE_BIN_REL)
        self.policy_path = executor.resolve_path(HOLO_POLKIT_POLICY_REL)

    def is_installed(self) -> bool:
        return self.bin_path.exists() and self.policy_path.exists()

    def apply(
        self,
        manifest_mgr: ManifestManager,
        manifest_data: Dict[str, Any],
    ) -> List[str]:
        actions: List[str] = []

        # Check if already installed via pacman
        res_pac = self.executor.run_cmd(["pacman", "-Q", "holo-realtek-firmware-toggles"], simulate_in_dry_run=True)
        if res_pac.returncode == 0:
            actions.append("Paket 'holo-realtek-firmware-toggles' ist bereits via pacman installiert.")
        else:
            # Check if pre-built package exists in workspace
            installed_via_pacman = False
            try:
                base_dir = Path(__file__).resolve().parent
                pkg_candidates = list(base_dir.glob("**/holo-realtek-firmware-toggles*.pkg.tar.zst"))
            except Exception:
                pkg_candidates = []

            if pkg_candidates and self.executor.root == Path("/") and not self.executor.dry_run:
                target_pkg = pkg_candidates[0]
                res_install = self.executor.run_cmd(["pacman", "-U", "--needed", "--noconfirm", str(target_pkg)])
                if res_install.success:
                    manifest_mgr.record_installed_package("holo-realtek-firmware-toggles", manifest_data)
                    actions.append(f"Paket '{target_pkg.name}' erfolgreich via pacman installiert.")
                    installed_via_pacman = True

            if not installed_via_pacman:
                # Install helper script and polkit policy directly
                manifest_mgr.record_created_file(self.bin_path, manifest_data)
                manifest_mgr.record_created_file(self.policy_path, manifest_data)

                self.executor.write_file(self.bin_path, HOLO_TOGGLE_SCRIPT_CONTENT, mode=0o755)
                self.executor.write_file(self.policy_path, HOLO_POLKIT_POLICY_CONTENT, mode=0o644)
                actions.append(f"Valve-Holo-Helper installiert: {self.bin_path}")
                actions.append(f"Polkit-Berechtigungsdatei installiert: {self.policy_path}")

        # If dongle is present or can run toggles, attempt set-low-latency-mode on
        if not self.executor.dry_run and self.bin_path.exists():
            res_toggle = self.executor.run_cmd([str(self.bin_path), "set-low-latency-mode", "on"])
            if res_toggle.success:
                actions.append("Valve-Holo-Low-Latency-Modus erfolgreich aktiviert (HW_SCAN aus, A-MSDU aus, EDCA aggressiv, MCS 0-9).")
            else:
                actions.append(f"Hinweis zu Holo-Toggles: {res_toggle.stderr.strip() or 'Wird automatisch beim Einstecken aktiviert'}")
        elif self.executor.dry_run:
            actions.append("[DRY-RUN] Würde Low-Latency-Modus via holo-realtek-firmware-toggles aktivieren.")

        return actions

    def revert(self, manifest_data: Dict[str, Any]) -> List[str]:
        actions: List[str] = []
        if self.bin_path.exists():
            self.executor.run_cmd([str(self.bin_path), "reset"])
            actions.append("Holo-Firmware-Toggles auf Werkseinstellungen zurückgesetzt ('reset').")
        return actions

