class ManifestManager:
    """Manages /var/lib/steamframe-setup/manifest.json and backup restorations."""

    def __init__(self, executor: SystemExecutor):
        self.executor = executor
        self.manifest_path = executor.resolve_path(MANIFEST_REL_PATH)
        self.backup_dir = executor.resolve_path(BACKUP_REL_DIR)

    def load_manifest(self) -> Dict[str, Any]:
        """Loads existing manifest, or returns an empty structure."""
        if not self.manifest_path.exists():
            return {}
        try:
            data = json.loads(self.manifest_path.read_text(encoding="utf-8"))
            return data
        except Exception as e:
            self.executor.logger.error(f"Failed to read manifest {self.manifest_path}: {e}")
            return {}

    def save_manifest(self, manifest_data: Dict[str, Any]) -> None:
        """Saves manifest_data to disk."""
        if self.executor.dry_run:
            self.executor.logger.info(f"[DRY-RUN] Would save manifest to {self.manifest_path}")
            return

        self.manifest_path.parent.mkdir(parents=True, exist_ok=True)
        content = json.dumps(manifest_data, indent=2, ensure_ascii=False)
        self.manifest_path.write_text(content, encoding="utf-8")
        try:
            self.manifest_path.chmod(0o600)
        except Exception:
            pass

    def backup_file(self, target_path: Path, manifest_data: Dict[str, Any]) -> None:
        """
        Backs up target_path before modification if not already backed up.
        Stores SHA256 and backup copy.
        """
        key = str(target_path)
        modified_files = manifest_data.setdefault("modified_files", {})
        if key in modified_files:
            # File already has a prior backup in this manifest session
            return

        if not target_path.exists():
            modified_files[key] = {
                "existed_before": False,
                "backup_path": None,
                "sha256": None,
            }
            return

        # Read content and compute hash
        content = target_path.read_bytes()
        sha = hashlib.sha256(content).hexdigest()

        # Destination in backup directory
        if not self.executor.dry_run:
            self.backup_dir.mkdir(parents=True, exist_ok=True)
            backup_file_name = f"{target_path.name}.{sha[:8]}.bak"
            backup_file_path = self.backup_dir / backup_file_name
            backup_file_path.write_bytes(content)
            try:
                backup_file_path.chmod(0o600)
            except Exception:
                pass
            backup_rel = str(backup_file_path)
        else:
            backup_rel = f"[DRY-RUN-BACKUP-OF-{target_path.name}]"

        modified_files[key] = {
            "existed_before": True,
            "backup_path": backup_rel,
            "sha256": sha,
        }

    def record_created_file(self, target_path: Path, manifest_data: Dict[str, Any]) -> None:
        """Records a file created by this tool in the manifest."""
        path_str = str(target_path)
        created = manifest_data.setdefault("created_files", [])
        if path_str not in created:
            created.append(path_str)

    def record_ufw_rule(self, rule_dict: Dict[str, Any], manifest_data: Dict[str, Any]) -> None:
        """Records a UFW rule applied by this tool."""
        rules = manifest_data.setdefault("ufw_rules", [])
        # Check duplicates
        for r in rules:
            if (
                r.get("port") == rule_dict.get("port")
                and r.get("proto") == rule_dict.get("proto")
                and r.get("scope") == rule_dict.get("scope")
                and r.get("iface") == rule_dict.get("iface")
            ):
                return
        rules.append(rule_dict)

    def record_installed_package(self, pkg_name: str, manifest_data: Dict[str, Any]) -> None:
        """Records a package installed by this tool."""
        pkgs = manifest_data.setdefault("installed_packages", [])
        if pkg_name not in pkgs:
            pkgs.append(pkg_name)

    def remove_manifest_and_backups(self) -> None:
        """Deletes manifest file and backup directory cleanly."""
        if self.executor.dry_run:
            self.executor.logger.info("[DRY-RUN] Would remove manifest file and backup directory")
            return
        if self.manifest_path.exists():
            try:
                self.manifest_path.unlink()
            except Exception as e:
                self.executor.logger.error(f"Failed to delete manifest: {e}")

        if self.backup_dir.exists():
            try:
                shutil.rmtree(self.backup_dir, ignore_errors=True)
            except Exception:
                pass

        # Also remove parent directory if empty
        try:
            parent = self.manifest_path.parent
            if parent.exists() and not any(parent.iterdir()):
                parent.rmdir()
        except Exception:
            pass

