class FirewallManager:
    """Detects active firewall and configures UFW rules safely."""

    def __init__(self, executor: SystemExecutor):
        self.executor = executor

    def detect_active_firewall(self) -> str:
        """
        Determines which firewall is active: 'ufw', 'firewalld', 'nftables', or 'none'.
        """
        # Check UFW
        res_ufw = self.executor.run_cmd(["ufw", "status"], simulate_in_dry_run=True)
        if res_ufw.returncode == 0 and "Status: active" in res_ufw.stdout:
            return "ufw"

        # Check firewalld
        res_fwd = self.executor.run_cmd(["firewall-cmd", "--state"], simulate_in_dry_run=True)
        if res_fwd.returncode == 0 and "running" in res_fwd.stdout:
            return "firewalld"

        # Check systemctl for active services
        res_ufw_svc = self.executor.run_cmd(["systemctl", "is-active", "ufw"], simulate_in_dry_run=True)
        if res_ufw_svc.returncode == 0 and res_ufw_svc.stdout.strip() == "active":
            return "ufw"

        res_nft_svc = self.executor.run_cmd(["systemctl", "is-active", "nftables"], simulate_in_dry_run=True)
        if res_nft_svc.returncode == 0 and res_nft_svc.stdout.strip() == "active":
            return "nftables"

        return "none"

    def get_existing_ufw_rules(self) -> List[str]:
        """Gets existing active UFW rules."""
        res = self.executor.run_cmd(["ufw", "status", "verbose"], simulate_in_dry_run=True)
        if res.returncode != 0:
            return []
        return [line.strip() for line in res.stdout.splitlines() if line.strip()]

    def is_rule_present(self, port: int, proto: str, scope: str, iface: Optional[str], existing_lines: List[str]) -> bool:
        """Checks if a rule for this port/proto already exists in UFW status output."""
        proto_lower = proto.lower()
        port_proto_str = f"{port}/{proto_lower}"
        for line in existing_lines:
            line_clean = line.lower()
            if port_proto_str in line_clean and "allow" in line_clean:
                if scope == "iface" and iface:
                    if iface.lower() in line_clean:
                        return True
                else:
                    return True
        return False

    def apply_rules(
        self,
        scope: str,
        iface: Optional[str],
        manifest_mgr: ManifestManager,
        manifest_data: Dict[str, Any],
    ) -> List[str]:
        """Applies missing UFW rules for VRLink ports."""
        applied_messages: List[str] = []
        fw_type = self.detect_active_firewall()

        if fw_type != "ufw":
            msg = (
                f"Firewall-Status: '{fw_type}' erkannt. UFW ist nicht aktiv.\n"
                "Firewall-Regeln werden nur bei aktiver UFW angewendet. Keine Änderungen vorgenommen."
            )
            print(Colors.colorize(msg, Colors.YELLOW))
            return applied_messages

        if scope == "iface" and not iface:
            msg = (
                "UFW-Scope ist auf 'iface' gesetzt, aber es wurde kein Dongle-Interface gefunden.\n"
                "Überspringe Firewall-Freigaben (oder nutzen Sie --ufw-scope all)."
            )
            print(Colors.colorize(msg, Colors.YELLOW))
            return applied_messages

        existing_lines = self.get_existing_ufw_rules()

        for p_info in VRLINK_PORTS:
            port = p_info["port"]
            proto = p_info["proto"]
            desc = p_info["desc"]

            if self.is_rule_present(port, proto, scope, iface, existing_lines):
                self.executor.logger.info(f"UFW rule for {port}/{proto} already present.")
                continue

            # Build command
            if scope == "iface" and iface:
                cmd = [
                    "ufw", "allow", "in", "on", iface,
                    "to", "any", "port", str(port), "proto", proto,
                    "comment", FIREWALL_COMMENT,
                ]
                del_cmd = [
                    "ufw", "delete", "allow", "in", "on", iface,
                    "to", "any", "port", str(port), "proto", proto,
                ]
            else:
                cmd = [
                    "ufw", "allow", f"{port}/{proto}",
                    "comment", FIREWALL_COMMENT,
                ]
                del_cmd = [
                    "ufw", "delete", "allow", f"{port}/{proto}",
                ]

            res = self.executor.run_cmd(cmd)
            if res.success:
                rule_record = {
                    "port": port,
                    "proto": proto,
                    "scope": scope,
                    "iface": iface if scope == "iface" else None,
                    "delete_cmd": del_cmd,
                }
                manifest_mgr.record_ufw_rule(rule_record, manifest_data)
                applied_messages.append(f"UFW: {port}/{proto} ({desc}) freigegeben [Scope: {scope}]")
            else:
                applied_messages.append(f"Fehler bei UFW {port}/{proto}: {res.stderr}")

        return applied_messages

    def revert_rules(self, manifest_data: Dict[str, Any]) -> List[str]:
        """Reverts all UFW rules recorded in manifest."""
        reverted: List[str] = []
        rules = manifest_data.get("ufw_rules", [])

        if not rules:
            return reverted

        fw_type = self.detect_active_firewall()
        if fw_type != "ufw" and not self.executor.dry_run:
            reverted.append("UFW ist inaktiv; gespeicherte UFW-Regeln werden dennoch gelöscht.")

        for r in rules:
            del_cmd = r.get("delete_cmd")
            port = r.get("port")
            proto = r.get("proto")
            if not del_cmd:
                # Fallback delete syntax
                if r.get("scope") == "iface" and r.get("iface"):
                    del_cmd = ["ufw", "delete", "allow", "in", "on", r["iface"], "to", "any", "port", str(port), "proto", proto]
                else:
                    del_cmd = ["ufw", "delete", "allow", f"{port}/{proto}"]

            res = self.executor.run_cmd(del_cmd)
            if res.success or "could not find" in res.stderr.lower():
                reverted.append(f"UFW-Regel entfernt: {port}/{proto}")
            else:
                reverted.append(f"UFW-Regel {port}/{proto} konnte nicht entfernt werden: {res.stderr.strip()}")

        # Reload UFW to apply clean state
        self.executor.run_cmd(["ufw", "reload"])
        return reverted

