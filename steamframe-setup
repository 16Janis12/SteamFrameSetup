# Hardware & Interface Detection
# ==============================================================================

class DongleDetector:
    """Scans and detects the Steam Frame wireless dongle (rtw89 driver)."""

    def __init__(self, executor: SystemExecutor):
        self.executor = executor

    def scan_interfaces(self) -> List[DongleInfo]:
        """Scans sysfs for network interfaces and driver associations."""
        net_dir = self.executor.resolve_path("sys/class/net")
        results: List[DongleInfo] = []

        if not net_dir.exists():
            return results

        for iface_entry in sorted(net_dir.iterdir()):
            iface_name = iface_entry.name
            # Skip loopback and obvious virtual adapters
            if iface_name == "lo" or iface_name.startswith(("tailscale", "tun", "tap", "docker", "veth", "br")):
                continue

            driver_symlink = iface_entry / "device" / "driver"
            driver_name = ""
            driver_path = ""
            bus = "unknown"

            if driver_symlink.exists():
                try:
                    driver_target = driver_symlink.resolve()
                    driver_name = driver_target.name
                    driver_path = str(driver_target)
                except Exception:
                    pass

            # Detect bus type
            device_dir = iface_entry / "device"
            if device_dir.exists():
                try:
                    subsys = (device_dir / "subsystem").resolve().name
                    if subsys == "pci":
                        bus = "pci"
                    elif subsys == "usb" or "usb" in str(device_dir.resolve()):
                        bus = "usb"
                except Exception:
                    pass

            # Read MAC address if present
            mac = ""
            addr_file = iface_entry / "address"
            if addr_file.exists():
                try:
                    mac = addr_file.read_text(encoding="utf-8").strip()
                except Exception:
                    pass

            is_rtw89 = "rtw89" in driver_name.lower()

            results.append(
                DongleInfo(
                    iface=iface_name,
                    driver=driver_name,
                    driver_path=driver_path,
                    bus=bus,
                    mac=mac,
                    is_rtw89=is_rtw89,
                )
            )

        return results

    def find_dongle(self, requested_iface: Optional[str] = None, interactive: bool = True) -> Optional[DongleInfo]:
        """
        Locates the appropriate dongle interface.
        Protects the internal WLAN card from accidental modification.
        """
        all_ifaces = self.scan_interfaces()

        if requested_iface:
            matched = [i for i in all_ifaces if i.iface == requested_iface]
            if not matched:
                # Interface requested by user but doesn't exist in sysfs
                return DongleInfo(
                    iface=requested_iface,
                    driver="manual",
                    driver_path="",
                    bus="unknown",
                    is_rtw89=True,
                )
            selected = matched[0]
            if not selected.is_rtw89:
                print(
                    Colors.colorize(
                        f"WARNUNG: Die angegebene Schnittstelle '{requested_iface}' nutzt den Treiber '{selected.driver}' (nicht rtw89)!",
                        Colors.YELLOW,
                    )
                )
            return selected

        # Auto-detect candidates using rtw89 driver
        candidates = [i for i in all_ifaces if i.is_rtw89]

        if not candidates:
            return None

        if len(candidates) == 1:
            return candidates[0]

        # Multiple candidates found: prompt user
        print(Colors.colorize("Mehrere Dongle-Kandidaten (rtw89) gefunden:", Colors.CYAN))
        for idx, cand in enumerate(candidates, 1):
            print(f"  {idx}) {cand.iface} (Treiber: {cand.driver}, Bus: {cand.bus}, MAC: {cand.mac})")

        if not interactive:
            print(Colors.colorize("Fehler: Mehrere rtw89-Schnittstellen gefunden. Bitte Schnittstelle mit --iface angeben.", Colors.RED))
            sys.exit(1)

        while True:
            try:
                choice = input(f"Bitte wählen [1-{len(candidates)}]: ").strip()
                if choice.isdigit() and 1 <= int(choice) <= len(candidates):
                    return candidates[int(choice) - 1]
            except (KeyboardInterrupt, EOFError):
                sys.exit(1)

