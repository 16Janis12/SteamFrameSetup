def get_target_user(executor: SystemExecutor) -> Tuple[str, Path, int, int]:
    """
    Identifies the invoking non-root user (via SUDO_USER or current login)
    and returns (username, user_home, uid, gid).
    Respects executor.root for fake-root test environments.
    """
    sudo_user = os.environ.get("SUDO_USER")
    username = sudo_user or os.environ.get("USER") or os.getlogin()

    try:
        pw = pwd.getpwnam(username)
        real_home = Path(pw.pw_dir)
        uid = pw.pw_uid
        gid = pw.pw_gid
    except Exception:
        real_home = Path.home()
        uid = os.getuid()
        gid = os.getgid()

    if executor.root != Path("/"):
        # Sandbox / fake-root environment: resolve inside fake-root
        user_home = executor.resolve_path(real_home)
    else:
        user_home = real_home

    return username, user_home, uid, gid

